<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- protoc / buf は protoc-gen-<名前> の実行ファイルを探す -->
    <AssemblyName>protoc-gen-voltech-grpc</AssemblyName>
    <RootNamespace>ProtocGenVoltechGrpc</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>protoc-gen-voltech-grpc</ToolCommandName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity のパッケージ(package.json)の org.nuget.google.protobuf と同じにする(make deps-check が確かめる) -->
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <!-- errors サブコマンドがエラーの定義ファイル(errors.toml)を読む -->
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProtocGenVoltechGrpc.Tests" />
  </ItemGroup>

</Project>
