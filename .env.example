# .env にコピーして使う(.env はコミットしない)
APP_ENV=development
# 基盤(server/rust)のテストが使う DB
DATABASE_URL=mysql://app:app@localhost:13306/app
# sandbox のサーバーが使う DB
SANDBOX_DATABASE_URL=mysql://app:app@localhost:13306/voltech_sandbox
LISTEN_ADDR=0.0.0.0:50051
SERVER_STATUS_PATH=sandbox/server/config/server_status.toml
